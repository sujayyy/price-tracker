<!doctype html>
<html>
  <body style="margin:0;padding:24px;background:#f5f5f4;font-family:-apple-system,Segoe UI,Roboto,sans-serif;color:#1c1917;">
    <table role="presentation" width="100%" style="max-width:600px;margin:0 auto;background:#ffffff;border-radius:12px;border:1px solid #e7e5e4;">
      <tr>
        <td style="padding:24px;">
          <p style="margin:0 0 4px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:{{ tag_color }};font-weight:700;">{{ tag }} · {{ event_label }}</p>
          <h1 style="margin:0 0 4px;font-size:18px;line-height:1.35;">{{ title }}</h1>
          <p style="margin:0 0 16px;font-size:12px;color:#78716c;">{% if sku %}Our SKU {{ sku }} · {% endif %}{{ rows | length }} competitor listing{{ "s" if rows | length != 1 }}</p>

          <p style="margin:0 0 8px;font-size:14px;">What changed on <strong>{{ marketplace }}</strong>: {% if competitor_prev %}<span style="color:#a8a29e;text-decoration:line-through;">{{ competitor_prev }}</span> → {% endif %}<strong>{{ competitor_now }}</strong></p>
          <table role="presentation" width="100%" style="border-collapse:collapse;font-size:14px;margin:0 0 16px;">
            {% for r in rows %}
            <tr style="border-top:1px solid #e7e5e4;{% if r.lowest %}background:#f0fdf4;{% endif %}">
              <td style="padding:8px 6px;color:#57534e;">{% if r.url %}<a href="{{ r.url }}" style="color:#57534e;">{{ r.marketplace }}</a>{% else %}{{ r.marketplace }}{% endif %}{% if r.lowest %} <span style="font-size:11px;color:#047857;font-weight:700;">LOWEST</span>{% endif %}{% if r.suspect %} <span style="font-size:11px;color:#be123c;">suspect reading, ignored</span>{% endif %}</td>
              <td style="padding:8px 6px;text-align:right;font-weight:600;">{% if r.changed and r.previous %}<span style="color:#a8a29e;font-weight:400;text-decoration:line-through;">{{ r.previous }}</span> {% endif %}{{ r.price }}</td>
            </tr>
            {% endfor %}
            <tr style="border-top:2px solid #d6d3d1;">
              <td style="padding:8px 6px;color:#57534e;font-weight:600;">Our price</td>
              <td style="padding:8px 6px;text-align:right;font-weight:700;">{{ our_price }}{% if gap %} <span style="font-weight:400;color:#78716c;">({{ gap }})</span>{% endif %}</td>
            </tr>
            {% if floor %}
            <tr style="border-top:1px solid #e7e5e4;">
              <td style="padding:8px 6px;color:#57534e;">Our floor</td>
              <td style="padding:8px 6px;text-align:right;">{{ floor }}</td>
            </tr>
            {% endif %}
          </table>

          <div style="margin:0 0 16px;padding:14px 16px;border-radius:10px;background:#f5f5f4;">
            <p style="margin:0 0 6px;font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:#78716c;">AI recommendation</p>
            <p style="margin:0 0 8px;font-size:20px;font-weight:700;">{{ action_line }}</p>
            <p style="margin:0 0 8px;font-size:14px;line-height:1.5;">{{ d.reasoning }}</p>
            <p style="margin:0;font-size:12px;color:#78716c;">
              Market read: <strong>{{ d.market_read | replace("_", " ") }}</strong> · Urgency: <strong>{{ d.urgency }}</strong> · Confidence {{ "%.0f" | format(d.confidence * 100) }}%
            </p>
          </div>

          {% if notes %}
          <ul style="margin:0 0 16px;padding-left:18px;font-size:12px;color:#b45309;">
            {% for n in notes %}<li>{{ n }}</li>{% endfor %}
          </ul>
          {% endif %}

          <a href="{{ review_url }}" style="display:inline-block;padding:10px 16px;background:#1c1917;color:#ffffff;border-radius:8px;text-decoration:none;font-size:14px;font-weight:600;">{{ button }}</a>
        </td>
      </tr>
    </table>
    <p style="max-width:600px;margin:12px auto 0;font-size:11px;color:#a8a29e;text-align:center;">Competitor price monitoring · sent to the operations team. Price changes are applied only after approval{% if auto_note %} or within the item's auto-apply limit{% endif %}.</p>
  </body>
</html>
