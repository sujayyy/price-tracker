# Copy to infra/.env and fill in. Never commit the real .env.

DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker

# --- AI layer -------------------------------------------------------------
# "provider:model" string passed to LangChain's init_chat_model.
# Install the matching provider extra for the backend (google / anthropic / openai / ollama).
AGENT_MODEL=google_genai:gemini-3.6-flash
# Provider extra installed in the backend Docker image; must match AGENT_MODEL's provider.
AI_PROVIDER=google
GOOGLE_API_KEY=            # or ANTHROPIC_API_KEY / OPENAI_API_KEY for your chosen provider
# Hard cap on analyst-agent invocations per UTC day. Past this, alerts fall back to
# "rule fired, no LLM judgment available".
# Cost cap on AI runs per day (UTC). One Haiku run costs a fraction of a cent; raise it for demos.
MAX_AGENT_INVOCATIONS_PER_DAY=200
ALERT_MIN_CONFIDENCE=0.7
# Second opinion: a critic agent reviews each proposed price change (holds are never reviewed).
# Its concerns can only send an auto-apply to a person. Empty model = AGENT_MODEL.
SECOND_OPINION_ENABLED=true
SECOND_OPINION_MODEL=

# --- Observability --------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=price-tracker

# --- Email (Gmail SMTP + app password) ------------------------------------
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=
# 587 = STARTTLS (default); 465 = implicit TLS. Some networks block 465.
SMTP_PORT=587

# --- Scheduler ------------------------------------------------------------
# Shared secret sent as X-Internal-Secret to POST /internal/run-once.
INTERNAL_RUN_SECRET=
# Demo/test input: POST /internal/demo/price simulates a marketplace price for one item and
# runs the normal pipeline (rules, agent, cooldown, email). Local demos only.
DEMO_ENDPOINTS_ENABLED=false

# --- Scraping -------------------------------------------------------------
# Minimum seconds between two requests to the same marketplace domain.
SOURCE_MIN_INTERVAL_SECONDS=5

# --- Web ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Every competitor alert goes to the operations team (comma-separated), plus an item's optional notify_email.
OPS_ALERT_EMAILS=ops-team@yourcompany.com
# Link target for "Review & approve" in alert emails.
DASHBOARD_URL=http://localhost:5173

# --- API load protection ------------------------------------------------
# At most this many /api requests run at once; the rest wait up to the timeout, then get 503.
API_MAX_CONCURRENCY=10
API_QUEUE_TIMEOUT_SECONDS=10
